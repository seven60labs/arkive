# ARKive device config -> copy to /etc/arkive/arkive.env (read by install.sh and mini-kiwix.service)
ARKIVE_HOST=arkive.lan          # hostname hotspot clients use (dnsmasq maps it to AP_ADDR)
AP_SSID=ARKive                  # hotspot name (mini-radio-boot may re-roll a random SSID at boot)
AP_ADDR=10.42.0.1/24            # hotspot address (NetworkManager "shared" mode)
AP_IFACE=wlan0
ARKIVE_USER=arkive              # unprivileged user that runs kiwix-serve and owns /srv/archive
TZ=UTC
