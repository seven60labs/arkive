# ARKive device config -> copy to /etc/arkive/arkive.env (read by install.sh and mini-kiwix.service)
# Keep comments on their own lines: systemd EnvironmentFile= does not strip trailing '# ...'.
# hostname hotspot clients use (dnsmasq maps it to AP_ADDR)
ARKIVE_HOST=arkive.lan
# hotspot name (mini-radio-boot may re-roll a random SSID at boot)
AP_SSID=ARKive
# hotspot address (NetworkManager "shared" mode)
AP_ADDR=10.42.0.1/24
AP_IFACE=wlan0
# unprivileged user that runs kiwix-serve and owns /srv/archive
ARKIVE_USER=arkive
TZ=UTC
