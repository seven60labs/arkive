 "sections": [
  {
   "id": "mindset",
   "title": "Mindset",
   "blurb": "Calm first; everything else goes better after it",
   "message": "If you are reading this, you are already doing great. You stopped, you are thinking, and you are looking for answers. That is exactly what people who come through hard situations do.",
   "points": [
    {
     "title": "Breathe",
     "text": "Breathe in slowly for a count of four, hold for four, and breathe out for four. Do it a few times. It steadies your heart and clears your thinking."
    },
    {
     "title": "Stay put",
     "text": "If you are lost or stranded, staying where you are is usually the safest choice. It saves energy and makes you easier to find, especially if someone knows your plans."
    },
    {
     "title": "Keep hope",
     "text": "Most people in trouble are found or find their own way out. Set small goals, one hour at a time, and notice each one you reach. Hope is a survival skill, and you can practise it."
    }
   ],
