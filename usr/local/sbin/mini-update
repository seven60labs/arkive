#!/usr/bin/env python3
"""ARKive updater (root helper). minitools may run ONLY: mini-update check | apply | rollback (see /etc/sudoers.d/023-mini-update).
check     ask GitHub for the newest release (or vX.Y.Z tag) and compare with /opt/mini-web/VERSION -> STATE/check.json
apply     download + verify the release found by the last check and install it, in a detached systemd unit (survives the
          mini-web restart); progress -> STATE/update.log, STATE/apply.json. A rollback tarball is taken first and restored
          automatically if install.sh fails or the panel does not come back.
rollback  restore the newest rollback tarball (previous version), detached the same way.
Source: public GitHub, unauthenticated (API, with codeload.github.com as tarball fallback). Optional, not in the UI:
/etc/arkive/update.conf (root-owned, KEY=VALUE): REPO=owner/name, API=https://api.github.com, CODELOAD=https://codeload.github.com,
TOKEN_FILE=/etc/arkive/update.token (root 0600; sent as a header from a 0600 temp file, never logged or shown)."""
import os, sys, json, re, time, subprocess, tarfile, shutil, tempfile, urllib.request, urllib.error, glob
STATE = "/var/lib/arkive-update"; LOG = STATE + "/update.log"; RB = STATE + "/rollback"; DL = STATE + "/dl"
CUR = "/opt/mini-web/VERSION"
KEEP = ["opt/mini-web", "usr/local/lib/arkive"] + [p.lstrip("/") for p in ("/usr/local/sbin/mini-*", "/etc/systemd/system/mini-*", "/etc/sudoers.d/02*-mini-*")]
def conf():
    c = {"REPO": "seven60labs/arkive", "API": "https://api.github.com", "CODELOAD": "https://codeload.github.com", "TOKEN_FILE": "/etc/arkive/update.token"}
    try:
        st = os.stat("/etc/arkive/update.conf")
        if st.st_uid == 0 and not st.st_mode & 0o022:
            for l in open("/etc/arkive/update.conf"):
                k, _, v = l.strip().partition("=")
                if k in c and v: c[k] = v.strip().strip("'\"")
    except OSError: pass
    return c
def vt(s):
    m = re.fullmatch(r"v?(\d+)\.(\d+)\.(\d+)", (s or "").strip()); return tuple(map(int, m.groups())) if m else None
def local():
    try: return open(CUR).read().strip()
    except OSError: return "0.0.0"
def wj(name, d):
    os.makedirs(STATE, exist_ok=True); t = f"{STATE}/{name}.tmp"
    with open(t, "w") as f: json.dump(d, f)
    os.chmod(t, 0o644); os.replace(t, f"{STATE}/{name}")
def log(*a):
    with open(LOG, "a") as f: f.write(time.strftime("%H:%M:%S ") + " ".join(map(str, a)) + "\n")
def get(url, accept="application/vnd.github+json", to=None, timeout=20):
    c = conf(); h = {"Accept": accept, "User-Agent": "arkive-updater", "X-GitHub-Api-Version": "2022-11-28"}
    tf = c["TOKEN_FILE"]
    try:
        if os.path.isfile(tf) and os.stat(tf).st_uid == 0 and not os.stat(tf).st_mode & 0o077 and url.startswith(c["API"]):
            tok = open(tf).read().strip()
            if tok: h["Authorization"] = "Bearer " + tok
    except OSError: pass
    r = urllib.request.urlopen(urllib.request.Request(url, headers=h), timeout=timeout)
    if to is None: return r.read()
    with open(to, "wb") as f: shutil.copyfileobj(r, f, 1 << 20)
def neterr(e):
    if isinstance(e, urllib.error.HTTPError):
        if e.code in (401, 403, 404): return f"GitHub answered {e.code}: the repository is not public (or does not exist / rate limit hit), so this device cannot see its releases."
        return f"GitHub answered HTTP {e.code}."
    return "No internet connection: could not reach GitHub (" + type(getattr(e, "reason", e)).__name__ + "). Connect ethernet with internet and try again."
def check():
    c = conf(); loc = local(); out = {"local": loc, "checked": time.time(), "repo": c["REPO"]}
    try:
        rel = None
        try:
            j = json.loads(get(f'{c["API"]}/repos/{c["REPO"]}/releases?per_page=20'))
            rels = [r for r in j if not r.get("draft") and not r.get("prerelease") and vt(r.get("tag_name"))]
            if rels: r = max(rels, key=lambda r: vt(r["tag_name"])); rel = {"tag": r["tag_name"], "notes": (r.get("body") or "")[:20000], "name": r.get("name") or r["tag_name"], "url": r.get("html_url", ""), "kind": "release"}
        except urllib.error.HTTPError as e:
            if e.code not in (404,): raise
        if not rel:
            tags = [t["name"] for t in json.loads(get(f'{c["API"]}/repos/{c["REPO"]}/tags?per_page=100')) if vt(t["name"])]
            if tags: t = max(tags, key=vt); rel = {"tag": t, "notes": "", "name": t, "url": "", "kind": "tag"}
        if not rel: out.update(ok=True, latest=None, newer=False, msg="No releases or vX.Y.Z tags published yet.")
        else: out.update(ok=True, latest=rel["tag"].lstrip("v"), tag=rel["tag"], notes=rel["notes"], name=rel["name"], url=rel["url"], kind=rel["kind"],
                         newer=vt(rel["tag"]) > (vt(loc) or (0, 0, 0)))
    except Exception as e: out.update(ok=False, newer=False, msg=neterr(e))
    wj("check.json", out); print(json.dumps({k: v for k, v in out.items() if k != "notes"})); return 0 if out["ok"] else 2
def busy():
    return subprocess.run(["systemctl", "is-active", "--quiet", "arkive-update"]).returncode == 0
def detach(*a):
    if busy(): print("an update or rollback is already running"); return 1
    open(LOG, "w").close(); os.chmod(LOG, 0o644)
    r = subprocess.run(["systemd-run", "--unit=arkive-update", "--collect", "--quiet", "-p", "Nice=5", sys.argv[0], *a], capture_output=True, text=True)
    print((r.stdout + r.stderr).strip() or "started"); return r.returncode
def safe_members(tf):
    top = None
    for m in tf.getmembers():
        n = m.name
        if n.startswith("/") or ".." in n.split("/") or m.isdev(): raise ValueError(f"unsafe path in archive: {n}")
        if (m.issym() or m.islnk()) and (m.linkname.startswith("/") or ".." in m.linkname.split("/")): raise ValueError(f"unsafe link in archive: {n}")
        t = n.split("/")[0]; top = top or t
        if t != top: raise ValueError("archive has more than one top-level folder")
    return top
def snapshot(ver):
    os.makedirs(RB, mode=0o700, exist_ok=True)
    f = f"{RB}/arkive-{ver}-{time.strftime('%Y%m%d-%H%M%S')}.tgz"
    paths = [p for k in KEEP for p in (glob.glob("/" + k) if "*" in k else ["/" + k]) if os.path.exists(p)]
    subprocess.run(["tar", "czf", f, "--exclude=opt/mini-web/.git", "--exclude=__pycache__", "-C", "/", *[p.lstrip("/") for p in paths]], check=True)
    for old in sorted(glob.glob(f"{RB}/*.tgz"), key=os.path.getmtime)[:-3]: os.remove(old)  # keep the newest 3
    return f
def restore(f):
    log("restoring", os.path.basename(f))
    subprocess.run(["tar", "xzf", f, "-C", "/"], check=True)
    subprocess.run(["systemctl", "daemon-reload"])
    subprocess.run(["systemctl", "restart", "mini-web", "mini-videos", "mini-thumbs", "mini-player"])
def healthy(timeout=90):
    end = time.time() + timeout
    while time.time() < end:
        try:
            if urllib.request.urlopen("http://127.0.0.1:8080/admin/login", timeout=5).status == 200: return True
        except Exception: pass
        time.sleep(3)
    return False
def run_apply():
    st = {"state": "running", "started": time.time(), "from": local()}; wj("apply.json", st)
    def fail(msg, rb=None):
        log("FAILED:", msg)
        if rb:
            try: restore(rb); msg += " — previous version restored."; log("rollback done")
            except Exception as e: msg += f" — automatic rollback ALSO failed ({e}); run: sudo tar xzf {rb} -C / && sudo systemctl restart mini-web"
        st.update(state="failed", msg=msg, ended=time.time()); wj("apply.json", st); return 1
    try: ck = json.load(open(f"{STATE}/check.json"))
    except Exception: return fail("run Check for updates first")
    if not ck.get("newer"): return fail("no newer version in the last check")
    c = conf(); tag = ck["tag"]; st["to"] = ck["latest"]; wj("apply.json", st)
    if not re.fullmatch(r"v?\d+\.\d+\.\d+", tag): return fail("bad tag")
    shutil.rmtree(DL, ignore_errors=True); os.makedirs(DL, mode=0o700); tgz = f"{DL}/{tag}.tar.gz"
    log(f"downloading {c['REPO']} {tag}")
    try: get(f'{c["API"]}/repos/{c["REPO"]}/tarball/{tag}', accept="application/vnd.github+json", to=tgz, timeout=120)
    except Exception as e:
        log("API tarball failed:", neterr(e), "- trying codeload")
        try: get(f'{c["CODELOAD"]}/{c["REPO"]}/tar.gz/refs/tags/{tag}', accept="*/*", to=tgz, timeout=120)
        except Exception as e2: return fail(neterr(e2))
    log(f"downloaded {os.path.getsize(tgz)} bytes; verifying")
    try:
        with tarfile.open(tgz, "r:gz") as tf:
            top = safe_members(tf); tf.extractall(DL, filter="data") if hasattr(tarfile, "data_filter") else tf.extractall(DL)
        src = f"{DL}/{top}"
        for need in ("install.sh", "VERSION", "opt/mini-web/app.py"):
            if not os.path.isfile(f"{src}/{need}"): raise ValueError(f"release is missing {need}")
        v = open(f"{src}/VERSION").read().strip()
        if v != tag.lstrip("v"): raise ValueError(f"VERSION file says {v} but the tag is {tag}")
        for p in glob.glob(f"{src}/opt/mini-web/*.py") + [f"{src}/usr/local/sbin/mini-update"]:
            if os.path.isfile(p): compile(open(p, "rb").read(), p, "exec")
        r = subprocess.run(["sh", "-n", f"{src}/install.sh"], capture_output=True, text=True)
        if r.returncode: raise ValueError("install.sh has a syntax error")
    except Exception as e: return fail(f"verification failed: {e}")
    log("verified: tarball intact, paths safe, VERSION matches tag, Python + install.sh parse")
    try: rb = snapshot(local()); log("rollback saved:", rb)
    except Exception as e: return fail(f"could not save rollback: {e}")
    log("running install.sh (apt + files + service restarts; output follows)")
    with open(LOG, "a") as lf:
        r = subprocess.run(["sh", "install.sh"], cwd=src, stdout=lf, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL, env={**os.environ, "ARKIVE_UPDATE": "1"}, timeout=3600)
    if r.returncode: return fail(f"install.sh exited {r.returncode}", rb)
    if not healthy(): return fail("admin panel did not come back after the update", rb)
    if local() != tag.lstrip("v"): return fail(f"installed VERSION is {local()}, expected {tag}", rb)
    shutil.rmtree(DL, ignore_errors=True)
    log(f"done: now running {local()}"); st.update(state="done", msg=f"Updated to {local()}.", ended=time.time()); wj("apply.json", st)
    try: ck["newer"] = False; ck["local"] = local(); wj("check.json", ck)
    except Exception: pass
    return 0
def run_rollback():
    fs = sorted(glob.glob(f"{RB}/*.tgz"), key=os.path.getmtime); st = {"state": "running", "started": time.time(), "from": local(), "kind": "rollback"}; wj("apply.json", st)
    if not fs: log("no rollback tarball"); st.update(state="failed", msg="No previous version saved."); wj("apply.json", st); return 1
    restore(fs[-1]); ok = healthy()
    if ok: os.remove(fs[-1])
    st.update(state="done" if ok else "failed", msg=f"Rolled back to {local()}." if ok else "Rolled back, but the panel did not answer.", ended=time.time()); wj("apply.json", st); log(st["msg"]); return 0 if ok else 1
if __name__ == "__main__":
    if os.geteuid() != 0: sys.exit("run as root")
    os.umask(0o022); os.makedirs(STATE, exist_ok=True); os.chmod(STATE, 0o755)
    a = sys.argv[1:]
    if a == ["check"]: sys.exit(check())
    if a == ["apply"]: sys.exit(detach("_apply"))
    if a == ["rollback"]: sys.exit(detach("_rollback"))
    if a == ["_apply"] and os.environ.get("INVOCATION_ID"): sys.exit(run_apply())
    if a == ["_rollback"] and os.environ.get("INVOCATION_ID"): sys.exit(run_rollback())
    sys.exit("usage: mini-update check|apply|rollback")
